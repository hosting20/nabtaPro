# ════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env.local وضع القيم الحقيقية
# ════════════════════════════════════════════════════════════

# ── رابط الموقع (للتحويلات) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (المصادقة + قاعدة البيانات) ──
# من: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# مفتاح الخدمة (سرّي — للخادم فقط، يُستخدم في Stripe Webhook)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Anthropic (الذكاء الاصطناعي — على الخادم فقط، لا يصل المتصفح) ──
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Stripe (الاشتراكات) ──
# من: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# معرّف السعر (Price) لخطة Pro الشهرية
STRIPE_PRICE_ID=price_...
# سرّ التحقق من Webhook (من إعداد نقطة /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...
