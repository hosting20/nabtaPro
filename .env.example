# ════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env.local وضع القيم الحقيقية
# ════════════════════════════════════════════════════════════

# ── رابط الموقع (للتحويلات) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (المصادقة + قاعدة البيانات) ──
# من: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# مفتاح الخدمة (سرّي — للخادم فقط، صلاحيات إدارية على قاعدة البيانات)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Anthropic (الذكاء الاصطناعي — على الخادم فقط، لا يصل المتصفح) ──
ANTHROPIC_API_KEY=sk-ant-api03-...
# عدد التحاليل المجانية لكل مستخدم قبل طلب Pro (نموذج freemium، افتراضي 5)
FREE_AI_LIMIT=5

# ── PayLink (الدفع — بوابة سعودية) ──
# من لوحة تاجر PayLink: Settings → API Credentials
PAYLINK_API_ID=APP_ID_...
PAYLINK_SECRET_KEY=...
# بيئة PayLink: اختبار https://restpilot.paylink.sa | إنتاج https://restapi.paylink.sa
PAYLINK_BASE_URL=https://restapi.paylink.sa
# سعر اشتراك Pro الشهري بالريال السعودي (افتراضي 49، الأدنى 5)
PRO_PRICE=49
